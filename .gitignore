output*/
.cursor/
.vscode/
.conductor/
# Conductor's per-worktree agent scratch dir. Conductor also excludes this via
# .git/info/exclude, but that file is local-only and absent from a plain clone —
# so the rule lives here too. Holds the /ui-check fixture project (videos,
# workbook, manifests, screenshots) alongside agent notes.
.context/
.venv/
node_modules/
.claude/*
!.claude/skills
*.html
*.gif
*.png
*.csv
*.app/
# MindNode documents are research data. Note a .mindnode is a *directory*
# (a macOS file package), hence the trailing slash — and because git cannot
# re-include a file whose parent directory is excluded, the test fixture is
# re-included as a directory below, not by a path inside it.
*.mindnode/

# Files we want to keep
!assets/titlecard.png
!assets/endcard.png
!assets/icons/*
!assets/logos/*
!assets/web/*
!tests/fixtures/*.mindnode/